---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit', timeZone: 'UTC' });
---

<BaseLayout title="Blog" description="Writeups and notes on security engineering.">
  <span class="mono-label">// writeups & notes</span>
  <h1>Blog</h1>
  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <span class="date">{fmt(post.data.pubDate)}</span>
          <a class="title" href={`/blog/${post.id}/`}>{post.data.title}</a>
          <p>{post.data.description}</p>
        </li>
      ))
    }
  </ul>
</BaseLayout>
