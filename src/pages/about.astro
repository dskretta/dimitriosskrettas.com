---
import BaseLayout from '../layouts/BaseLayout.astro';
import { GITHUB_URL } from '../consts';
---

<BaseLayout title="About" description="Who I am and what I'm working toward in security.">
  <span class="mono-label">// whoami</span>
  <h1>About</h1>

  <p>
    I'm Dimitrios, a cybersecurity student at Eastern Michigan University
    (graduating December 2026) and incoming cybersecurity software engineer
    intern at <strong>Viasat</strong>. I'm interested in how systems
    break — and in building the detections, tooling, and habits that keep them
    from breaking quietly.
  </p>

  <p>
    Outside of work and school, I'm the lead organizer of
    <a href="https://www.bsidesdetroit.org">BSides Detroit</a>, helping run
    talks, workshops, and a CTF for the Michigan infosec community. I write up
    what I learn on the <a href="/blog/">blog</a> and keep my code on
    <a href={GITHUB_URL}>GitHub</a>.
  </p>

  <h2>Currently</h2>
  <ul>
    <li>Incoming — cybersecurity software engineer intern at Viasat</li>
    <li>Organizing — BSides Detroit</li>
    <li>Studying — finishing my bachelor's degree in cybersecurity, and learning Go on the side</li>
    <li>Building — a <a href="https://github.com/dskretta/homelab-infra">homelab managed as code</a> with Terraform, Proxmox, and OpenBao</li>
    <li>Researching — see the <a href="/research/">research</a> page</li>
  </ul>

  <h2>Contact</h2>
  <p>
    The best way to reach me is on
    <a href="https://www.linkedin.com/in/dimitrios-skrettas">LinkedIn</a>, or
    find my work on <a href={GITHUB_URL}>GitHub</a>.
  </p>
</BaseLayout>
