---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SOCIALS } from '../consts';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit', timeZone: 'UTC' });
---

<BaseLayout>
  <section class="hero">
    <p class="eyebrow">Security engineering · Detroit</p>
    <h1 class="hero-name">Dimitrios <span>Skrettas</span></h1>
    <hr class="rule" />
    <p class="lede">I build detections and DevSecOps tooling, break things in the lab, and write up what I learn along the way.</p>
    <div class="social-row">
      {SOCIALS.map(({ label, href }) => <a href={href} rel="me">{label}</a>)}
    </div>
  </section>

  <section>
    <p class="eyebrow">Currently</p>
    <dl class="currently">
      <div><dt>Building</dt><dd>DevSecOps pipelines and security tooling</dd></div>
      <div><dt>Studying</dt><dd>OSCP</dd></div>
      <div><dt>Recently</dt><dd>Lead organizer &amp; MC, BSides Detroit 2026</dd></div>
    </dl>
  </section>

  <section>
    <div class="section-head">
      <h2>Selected work</h2>
      <a class="more" href="/projects/">view all</a>
    </div>
    <div class="card-grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section>
    <div class="section-head">
      <h2>Recent writing</h2>
      <a class="more" href="/blog/">view all</a>
    </div>
    <ul class="post-list">
      {
        posts.map((post) => (
          <li>
            <span class="date">{fmt(post.data.pubDate)}</span>
            <a class="title" href={`/blog/${post.id}/`}>{post.data.title}</a>
            <p>{post.data.description}</p>
          </li>
        ))
      }
    </ul>
  </section>

  {/* TODO: live homelab status section goes here once wired to real infra — no placeholder data until then */}

  <section class="featured-in">
    <p class="muted">As featured in <a href="https://youtu.be/pb0kJXSy64E" target="_blank" rel="noopener">DEF CON documentary (CyberNews) →</a></p>
  </section>
</BaseLayout>
